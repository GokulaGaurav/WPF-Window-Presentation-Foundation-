<Window x:Class="Calciwbtn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="GG's Calculator"
        Height="600"
        Width="380"
        Background="#202020"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- Common Button Style -->
        <Style x:Key="CalcButton" TargetType="Button">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="65"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#505050"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#707070"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Operator Button -->
        <Style x:Key="OperatorButton"
               TargetType="Button"
               BasedOn="{StaticResource CalcButton}">
            <Setter Property="Background" Value="#FF9500"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFB340"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#CC7700"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Clear Button -->
        <Style x:Key="ClearButton"
               TargetType="Button"
               BasedOn="{StaticResource CalcButton}">
            <Setter Property="Background" Value="#A5A5A5"/>
            <Setter Property="Foreground" Value="#111111"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D0D0D0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Equal Button -->
        <Style x:Key="EqualButton"
               TargetType="Button"
               BasedOn="{StaticResource CalcButton}">
            <Setter Property="Background" Value="#00A8FF"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33B9FF"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>


    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Display -->
        <Border Grid.Row="0"
                Background="#151515"
                CornerRadius="15"
                Padding="10"
                Margin="0,10,0,20">

            <TextBox Name="rslt"
                     Height="80"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White"
                     FontSize="42"
                     FontWeight="Bold"
                     FontFamily="Segoe UI"
                     TextAlignment="Right"
                     VerticalContentAlignment="Center"
                     Padding="5"
                     IsReadOnly="False"/>
        </Border>


        <!-- Row 1 -->
        <UniformGrid Grid.Row="1" Columns="4">

            <Button Content="7"
                    Name="btn7"
                    Click="Number_click"
                    Style="{StaticResource CalcButton}"/>

            <Button Content="8"
                    Name="btn8"
                    Click="Number_click"
                    Style="{StaticResource CalcButton}"/>

            <Button Content="9"
                    Name="btn9"
                    Click="Number_click"
                    Style="{StaticResource CalcButton}"/>

            <Button Content="×"
                    Name="btnmult"
                    Click="Oper_Click"
                    Style="{StaticResource OperatorButton}"/>

        </UniformGrid>


        <!-- Row 2 -->
        <UniformGrid Grid.Row="2" Columns="4">

            <Button Content="4"
                    Name="btn4"
                    Click="Number_click"
                    Style="{StaticResource CalcButton}"/>

            <Button Content="5"
                    Name="btn5"
                    Click="Number_click"
                    Style="{StaticResource CalcButton}"/>

            <Button Content="6"
                    Name="btn6"
                    Click="Number_click"
                    Style="{StaticResource CalcButton}"/>

            <Button Content="+"
                    Name="btnadd"
                    Click="Oper_Click"
                    Style="{StaticResource OperatorButton}"/>

        </UniformGrid>


        <!-- Row 3 -->
        <UniformGrid Grid.Row="3" Columns="4">

            <Button Content="1"
                    Name="btn1"
                    Click="Number_click"
                    Style="{StaticResource CalcButton}"/>

            <Button Content="2"
                    Name="btn2"
                    Click="Number_click"
                    Style="{StaticResource CalcButton}"/>

            <Button Content="3"
                    Name="btn3"
                    Click="Number_click"
                    Style="{StaticResource CalcButton}"/>

            <Button Content="−"
                    Name="btnsub"
                    Click="Oper_Click"
                    Style="{StaticResource OperatorButton}"/>

        </UniformGrid>


        <!-- Row 4 -->
        <UniformGrid Grid.Row="4" Columns="4">

            <Button Content="0"
                    Name="btn0"
                    Click="Number_click"
                    Style="{StaticResource CalcButton}"/>

            <Button Content="÷"
                    Name="btndiv"
                    Click="Oper_Click"
                    Style="{StaticResource OperatorButton}"/>

            <Button Content="C"
                    Name="btnclr"
                    Click="btnclr_Click"
                    Style="{StaticResource ClearButton}"/>

            <Button Content="="
                    Name="btneq"
                    Click="btneq_Click"
                    Style="{StaticResource EqualButton}"/>

        </UniformGrid>

    </Grid>

</Window>