<Window x:Class="MyMonitor.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyMonitor"
        mc:Ignorable="d"
        Title="MyMonitor!" Height="450" Width="800" Background="DeepSkyBlue">
    <StackPanel HorizontalAlignment="Center" Margin="0,50,0,0">
        <TabControl>
            <TabItem Header="Login" FontFamily="Copperplate Gothic Bold" FontSize="20" Width="200" Background="Azure">
                <StackPanel HorizontalAlignment="Center" Background="Lavender">
                    <TextBlock Text="Username :" FontFamily="Century Gothic" Width="400" ></TextBlock>
                    <TextBox Name="txtuser" MaxLength="10"></TextBox>
                    <TextBlock Text="Password :" FontFamily="Century Gothic"></TextBlock>
                    <PasswordBox  Name="pwpass" MaxLength="10"></PasswordBox>
                    <Button Name="btnlog" Click="btnlog_Click" Content="Login" Background="LightSeaGreen" Margin="0,10,0,0" FontFamily="Bell MT"></Button>
                </StackPanel>
            </TabItem>
            <TabItem Header="Register" HorizontalAlignment="Right" FontFamily="Copperplate Gothic Bold" Margin="0,-2,-2,0" Width="200" FontSize="20" Background="Azure">
                <StackPanel Background="Lavender">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Username :" FontFamily="Century Gothic" ></TextBlock>
                        <TextBlock Text="*" Foreground="Red"></TextBlock>
                    </StackPanel>
                    <StackPanel>
                        <TextBox MaxLength="10" Name="txtreguser" FontFamily="Century Gothic"></TextBox>
                        <TextBlock Name="erruser" Foreground="red" FontFamily="Arial" ></TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Password :" FontFamily="Century Gothic" ></TextBlock>
                        <TextBlock Text="*" Foreground="Red"></TextBlock>
                    </StackPanel>
                    <StackPanel>
                        <PasswordBox MaxLength="10" Name="pwregpass" FontFamily="Century Gothic"></PasswordBox>
                        <TextBlock Name="errpass" Foreground="Red" FontFamily="Arial" ></TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Age :" FontFamily="Century Gothic"></TextBlock>
                        <TextBlock Text="*" Foreground="Red"></TextBlock>
                    </StackPanel>
                    <StackPanel>
                        <TextBox Name="txtage" MaxLength="3" FontFamily="Century Gothic"></TextBox>
                        <TextBlock Name="errage" Foreground="Red" FontFamily="Arial" ></TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Email :" FontFamily="Century Gothic"></TextBlock>
                        <TextBlock Text="*" Foreground="Red"></TextBlock>
                    </StackPanel>
                    <StackPanel>
                        <TextBox MaxLength="30" Name="txtemail" FontFamily="Century Gothic"></TextBox>
                        <TextBlock Name="erremail" Foreground="Red" FontFamily="Arial" ></TextBlock>
                    </StackPanel>
                    <Button Name="btnreg" Click="btnreg_Click" Content="Register" Background="LightSeaGreen" FontFamily="Bell MT"></Button>
                </StackPanel>
            </TabItem>
        </TabControl>
    </StackPanel>
</Window>
